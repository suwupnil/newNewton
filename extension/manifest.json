{
  "manifest_version": 3,
  "name": "newNewton",
  "version": "1.4.0",
  "key": "",
  "update_url": "https://raw.githubusercontent.com/suwupnil/newNewton/main/updates.xml",
  "description": "UX Enhancer for Newton School - Native Grauity Theme Switcher, Telemetry Blocker and Supabase Solution Archiver",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "declarativeNetRequest",
    "cookies",
    "notifications"
  ],
  "host_permissions": [
    "https://my.newtonschool.co/*",
    "https://*.newtonschool.co/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*",
    "https://ru-print.vercel.app/*",
    "https://*.supabase.co/*",
    "http://127.0.0.1:54321/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "48": "src/icons/icon48.png",
      "128": "src/icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://my.newtonschool.co/*",
        "https://*.newtonschool.co/*"
      ],
      "js": [
        "src/telemetry-blocker.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://my.newtonschool.co/*",
        "https://*.newtonschool.co/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/telemetry-blocker.js",
        "src/icons/*"
      ],
      "matches": [
        "https://my.newtonschool.co/*",
        "https://*.newtonschool.co/*"
      ]
    }
  ],
  "icons": {
    "16": "src/icons/icon16.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  }
}
