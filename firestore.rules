rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Quizzes collection
    match /quizzes/{assessmentHash} {
      // Anyone using the extension can read quiz solutions
      allow read: if true;
      // Direct client writes are blocked. Only Cloud Functions (Admin SDK) can write.
      allow write: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}